# GEMINI_API_KEY: Server-side Gemini API key for AI Mode (keep secret; never expose to Vite client code).
# Local Mode runs 100% offline in-browser and requires no API key.
# For local development, copy this file to `.env.local` or `.env` and set your key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional AI Mode model override (e.g. gemini-2.5-flash).
# GEMINI_MODEL="gemini-2.5-flash"

# Local server port (defaults to 3000)
PORT=3000

# APP_URL: Public base URL where the app is hosted.
APP_URL="http://localhost:3000"
